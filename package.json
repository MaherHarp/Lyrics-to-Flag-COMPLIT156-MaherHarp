    "format": "prettier -w .",
    "test": "pnpm -C packages/shared test && pnpm -C apps/api test && pnpm -C apps/web test"
  },
  "devDependencies": {
    "pnpm": "^9.15.5",
    "prettier": "^3.6.2"
  }
}
